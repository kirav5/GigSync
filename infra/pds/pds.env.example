# See https://github.com/bluesky-social/pds for every variable. Never commit the filled-in file.
PDS_HOSTNAME=pds.collabnetwork.ai
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=
# R2 as the blob store (S3 API)
PDS_BLOBSTORE_S3_BUCKET=collab-pds-blobs
PDS_BLOBSTORE_S3_REGION=auto
PDS_BLOBSTORE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PDS_BLOBSTORE_S3_ACCESS_KEY_ID=
PDS_BLOBSTORE_S3_SECRET_ACCESS_KEY=
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
PDS_DID_PLC_URL=https://plc.directory
# Open sign-up is off; the API Worker creates accounts for verified users with the admin password.
PDS_INVITE_REQUIRED=true
