{
  "name": "@gigsync/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The GigSync app: one React + Capacitor codebase for Android, iPhone and Mac.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_API_BASE=http://localhost:8788 vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "sync": "cap sync",
    "android": "cap run android",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-serif-devanagari": "5.3.0",
    "@fontsource/noto-serif-kannada": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@gigsync/core": "workspace:*",
    "@gigsync/crypto": "workspace:*",
    "@gigsync/plugin-speech": "workspace:*",
    "@gigsync/plugin-translate": "workspace:*",
    "@gigsync/protocol": "workspace:*",
    "@huggingface/transformers": "3.7.2",
    "firebase": "13.1.0",
    "jsqr": "1.4.0",
    "maplibre-gl": "5.22.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdfjs-dist": "5.4.624",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
