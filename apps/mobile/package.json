{
  "name": "@gigsync/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The GigSync app: one React + Capacitor codebase for Android, iPhone and Mac.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "sync": "cap sync",
    "android": "cap run android",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@gigsync/core": "workspace:*",
    "@gigsync/crypto": "workspace:*",
    "@gigsync/plugin-llm": "workspace:*",
    "@gigsync/plugin-translate": "workspace:*",
    "@gigsync/protocol": "workspace:*",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
