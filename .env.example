# Cloudflare (CI only; never commit real values)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Mobile app (Vite reads VITE_* at build time)
VITE_API_BASE=http://localhost:8787

# Dev only: answer with a model from Ollama on this computer (`ollama serve`, `ollama pull gemma3:1b`).
# Put it in apps/mobile/.env.development.local; release builds ignore it.
VITE_OLLAMA_MODEL=gemma3:1b
