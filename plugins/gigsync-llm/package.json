{
  "name": "@gigsync/plugin-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor plugin that runs a language model on the device: WebLLM on WebGPU in the web app, LiteRT-LM on Android, Apple Foundation Models on iPhone and Mac.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "android/src",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "8.5.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86"
  }
}
