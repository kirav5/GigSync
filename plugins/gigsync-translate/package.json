{
  "name": "@gigsync/plugin-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor plugin that translates free text on the device: Chrome's built-in translator on the web, ML Kit on Android, Apple Translation on iPhone. Never a cloud service.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "android/src",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "8.5.3",
    "typescript": "5.9.3"
  }
}
