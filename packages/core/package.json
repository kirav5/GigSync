{
  "name": "@gigsync/core",
  "version": "0.1.0",
  "private": true,
  "description": "The agent itself, in plain TypeScript: routing, experts, engagements, jobs, policy, mail, the API client. No browser or Capacitor imports.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js",
      "default": "./src/log.ts"
    },
    "./reader": {
      "types": "./dist/reader/input.d.ts",
      "import": "./dist/reader/input.js",
      "default": "./src/reader/input.ts"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./src/http.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gigsync/crypto": "workspace:*",
    "@gigsync/protocol": "workspace:*",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
