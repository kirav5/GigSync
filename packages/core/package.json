{
  "name": "@collab/core",
  "version": "0.1.0",
  "private": true,
  "description": "The agent itself, in plain TypeScript: routing, experts, engagements, policy, mail. No browser or Capacitor imports.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@collab/protocol": "workspace:*",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
