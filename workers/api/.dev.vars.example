# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
DEV_OTP=000000
PHONE_HMAC_KEY=dev-only-key
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Local logging: everything, private data included. Deployed Workers ignore LOG_PII (ENVIRONMENT is not "local").
ENVIRONMENT=local
LOG_LEVEL=debug
LOG_PII=true
# Admin-only routes (a mentor's vouched badge). Local value only; the deployed Worker uses `wrangler secret put ADMIN_KEY`.
ADMIN_KEY=dev-only-admin-key
# Job alerts by Web Push (push/webpush.ts): `node scripts/vapid-keys.mjs` prints a pair. Unset means no alerts.
# Deployed: VAPID_PUBLIC_KEY and VAPID_SUBJECT as [vars] in wrangler.toml, the private key by `wrangler secret put`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@gigsync.network
# Real SMS codes through Firebase phone sign-in (docs/setup/firebase-phone-sign-in.md): the Firebase project id. Unset
# means /v1/auth/phone/verify answers 503 and only DEV_OTP signs in. Deployed: FIREBASE_PROJECT_ID in wrangler.toml.
# FIREBASE_PROJECT_ID=
# Geocoding for the address form (ADR 0045): an Ola Maps key. Unset means the geo routes answer 503 and the app
# offers typing the address instead. Deployed: `wrangler secret put OLA_MAPS_API_KEY`.
# OLA_MAPS_API_KEY=
# Live cities (README "Live cities"): unset serves the directory's live cities; a comma list only those
# (bengaluru,kanpur); `*` lets every place in, for testing from anywhere. Leave it unset for the UI tests.
# LIVE_CITIES=*

# GigSync's own model (ADR 0052): Ollama on the Mac Studio. Unset, the model route answers 503 and phones use their
# own model or lite mode. Locally, the Studio's LAN address; deployed, the Cloudflare Tunnel's hostname, set as vars,
# with the Access service token as secrets (`wrangler secret put MODEL_ACCESS_ID`, `MODEL_ACCESS_SECRET`).
# MODEL_ORIGIN=http://192.168.1.8:11434
# MODEL_NAME=qwen3:30b-a3b-instruct-2507-q4_K_M
