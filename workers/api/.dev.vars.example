# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
DEV_OTP=000000
PHONE_HMAC_KEY=dev-only-key
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Local logging: everything, private data included. Deployed Workers ignore LOG_PII (ENVIRONMENT is not "local").
ENVIRONMENT=local
LOG_LEVEL=debug
LOG_PII=true
# Admin-only routes (a mentor's vouched badge). Local value only; the deployed Worker uses `wrangler secret put ADMIN_KEY`.
ADMIN_KEY=dev-only-admin-key
# Job alerts by Web Push (push/webpush.ts): `node scripts/vapid-keys.mjs` prints a pair. Unset means no alerts.
# Deployed: VAPID_PUBLIC_KEY and VAPID_SUBJECT as [vars] in wrangler.toml, the private key by `wrangler secret put`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@gigsync.network
# Geocoding for the address form (ADR 0045): an Ola Maps key. Unset means the geo routes answer 503 and the app
# offers typing the address instead. Deployed: `wrangler secret put OLA_MAPS_API_KEY`.
# OLA_MAPS_API_KEY=
