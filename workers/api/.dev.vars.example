# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
DEV_OTP=000000
PHONE_HMAC_KEY=dev-only-key
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Local logging: everything, private data included. Deployed Workers ignore LOG_PII (ENVIRONMENT is not "local").
ENVIRONMENT=local
LOG_LEVEL=debug
LOG_PII=true
# Admin-only routes (a mentor's vouched badge). Local value only; the deployed Worker uses `wrangler secret put ADMIN_KEY`.
ADMIN_KEY=dev-only-admin-key
# Rate estimates (ADR 0030). The model key is a secret: `wrangler secret put ANTHROPIC_API_KEY` when deployed. Leave it
# empty locally unless you mean to read the web; with no key and no fixture, estimates answer "no estimate".
ANTHROPIC_API_KEY=
# "fixture" serves canned quotes for painter 2BHK, cook and maid in Bengaluru, with no web call (local only).
ESTIMATE_SOURCE=fixture
