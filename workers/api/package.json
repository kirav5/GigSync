{
  "name": "@collab/worker-api",
  "version": "0.1.0",
  "private": true,
  "description": "The public API: sign-in, directory, mailbox routes. Deploys the Mailbox Durable Object.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply collab-directory --local",
    "db:migrate:remote": "wrangler d1 migrations apply collab-directory --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@collab/protocol": "workspace:*",
    "@collab/worker-mailbox": "workspace:*",
    "hono": "4.13.13",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
